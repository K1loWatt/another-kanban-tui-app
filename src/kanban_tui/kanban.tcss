Screen {
    background: #0b0d13;
}

Header {
    background: #11141c;
    color: #e2e8f0;
}

Footer {
    background: #11141c;
}

#board {
    height: 1fr;
    padding: 1 2;
}

Column {
    width: 1fr;
    height: 1fr;
    margin: 0 1;
    background: #11141c;
    border: round #262b3a;
}

Column.active-column {
    border: round #60a5fa;
}

.column-header {
    height: 1;
    padding: 0 1;
    background: #161a24;
    color: #94a3b8;
    text-style: bold;
    text-align: center;
}

Column.column-backlog .column-header {
    color: #93c5fd;
}

Column.column-doing .column-header {
    color: #fbbf24;
}

Column.column-done .column-header {
    color: #34d399;
}

.column-body {
    padding: 1;
    scrollbar-size: 1 1;
}

.empty-hint {
    color: #475569;
    padding: 1;
    text-align: center;
}

TaskCard {
    width: 1fr;
    height: auto;
    min-height: 3;
    margin-bottom: 0;
    padding: 0 1;
    background: #171b26;
    border: round #2b3141;
    color: #cbd5e1;
}

/* Urgente: parpadea en rojo */
TaskCard.alert-urgent {
    border: round #f87171;
}

TaskCard.alert-urgent.blink-active {
    background: #7f1d1d;
    color: #fff1f2;
    border: round #fca5a5;
}

/* Fecha límite próxima: parpadea en amarillo */
TaskCard.alert-approaching {
    border: round #fbbf24;
}

TaskCard.alert-approaching.blink-active {
    background: #78350f;
    color: #fffbeb;
    border: round #fde047;
}

/* Vencida: borde rojo fijo (sin parpadeo) */
TaskCard.alert-overdue {
    border: round #f87171;
    color: #fecaca;
}

/* Prioridad baja: borde verde fijo */
TaskCard.alert-low {
    border: round #34d399;
    color: #d1fae5;
}

TaskCard.selected {
    border: double #60a5fa;
    background: #1e293b;
}

TaskCard.selected.blink-active {
    border: double #fde047;
}

TaskFormScreen, ConfirmScreen {
    align: center middle;
}

#form-dialog, #confirm-dialog {
    width: 76;
    max-width: 90%;
    height: auto;
    max-height: 90%;
    background: #11141c;
    border: round #60a5fa;
    padding: 1 2;
}

#confirm-dialog {
    width: 50%;
}

#form-title {
    text-style: bold;
    color: #e2e8f0;
    padding-bottom: 1;
}

#form-body {
    height: auto;
    max-height: 24;
}

#f-description {
    height: 6;
    border: round #2b3141;
    margin-bottom: 1;
}

#form-body Label {
    height: 1;
    margin: 0;
    color: #94a3b8;
}

#form-body Input {
    margin-bottom: 1;
}

#form-body Select {
    margin-bottom: 0;
}

.form-row {
    height: auto;
    margin-bottom: 1;
}

.form-col {
    width: 1fr;
    height: auto;
    margin-right: 1;
}

#form-actions, #confirm-actions {
    height: auto;
    padding-top: 1;
    align: right middle;
}

#form-actions Button, #confirm-actions Button {
    margin-left: 1;
}

#form-error {
    color: #f87171;
    height: auto;
    padding-top: 1;
}

#confirm-message {
    padding-bottom: 1;
}
