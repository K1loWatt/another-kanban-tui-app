* {
    scrollbar-background: #313442;
    scrollbar-background-hover: #3b3e4d;
    scrollbar-background-active: #3b3e4d;
    scrollbar-color: #6272a4;
    scrollbar-color-hover: #bd93f9;
    scrollbar-color-active: #ff79c6;
    scrollbar-corner-color: #313442;
}

Screen {
    background: #282a36;
}

Header {
    background: #313442;
    color: #f8f8f2;
}

Footer {
    background: #313442;
}

#board-header {
    height: 1;
    padding: 0 3;
}

.board-col-header {
    width: 1fr;
    text-style: bold;
    color: #6272a4;
}

#board {
    height: 1fr;
    padding: 1 2;
}

Lane {
    height: auto;
    margin-bottom: 1;
    padding: 0 1 1 1;
    border-top: solid #44475a;
}

/* El color (y, para carriles de objetivo, el grosor activo/inactivo) del
   border-top se calcula en Python — ver Lane._refresh_border en lane.py —
   según la frescura del carril (verde -> rojo) o su estado (urgencias /
   apagado). La regla de arriba es solo el valor por defecto antes del
   primer render. */

/* Objetivo apagado: todo en gris, pero sigue editable con normalidad. */
Lane.paused-lane .lane-title,
Lane.paused-lane .lane-description {
    color: #6b6b6b;
}

Lane.paused-lane TaskCard {
    color: #6b6b6b;
    border-left: thick #4a4a4a;
    background: transparent;
    text-style: none;
}

Lane.paused-lane TaskCard.blink-active {
    color: #6b6b6b;
    background: transparent;
}

Lane.paused-lane TaskCard.selected {
    background: #333333;
    color: #cfcfcf;
    text-style: bold;
}

#stats-banner {
    height: 1;
    width: 1fr;
    background: #323548;
    content-align: center middle;
    margin-bottom: 1;
}

.lane-header {
    height: 1;
    margin-bottom: 0;
    align: left middle;
}

.lane-title {
    width: 1fr;
    color: #f8f8f2;
}

.lane-description {
    height: 1;
    color: #6272a4;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.lane-body {
    height: auto;
}

Column {
    width: 1fr;
    height: auto;
    max-height: 30;
    padding: 0 1;
}

.empty-hint {
    color: #6272a4;
    height: 1;
    padding: 0 1;
}

TaskCard {
    width: 1fr;
    height: 3;
    padding: 0 1;
    background: transparent;
    color: #f8f8f2;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* Bloqueada por otra tarea del mismo objetivo: roja fija, no se puede pillar */
TaskCard.alert-blocked {
    color: #ff9580;
    border-left: thick #ff5555;
    text-style: bold;
}

/* Lleva demasiados días en progreso: morada fija, toca cerrarla o partirla */
TaskCard.alert-stuck {
    color: #d6acff;
    border-left: thick #bd93f9;
}

/* Expedito: parpadea en rojo */
TaskCard.alert-urgent {
    color: #ffb3a0;
    border-left: thick #ff5555;
}

TaskCard.alert-urgent.blink-active {
    background: #4a1f1f;
    color: #ffd9cf;
}

/* Fecha límite próxima: parpadea en ámbar */
TaskCard.alert-approaching {
    border-left: thick #ffb86c;
}

TaskCard.alert-approaching.blink-active {
    background: #4a3b1f;
    color: #ffe9bd;
}

/* Vencida: marca roja fija (sin parpadeo) */
TaskCard.alert-overdue {
    border-left: thick #ff5555;
    color: #ffbdb0;
}

/* Prioridad baja: marca verde fija */
TaskCard.alert-low {
    border-left: thick #50fa7b;
}

TaskCard.selected {
    background: #44475a;
    color: #ff79c6;
    text-style: bold;
}

TaskCard.selected.blink-active {
    background: #4d5066;
    color: #ffa0dc;
}

TaskFormScreen, ConfirmScreen {
    align: center middle;
}

#form-dialog, #confirm-dialog {
    height: auto;
    max-height: 96%;
    background: #313442;
    border: round #bd93f9;
    padding: 1 2;
}

#form-dialog {
    width: 94%;
    height: 94%;
}

#confirm-dialog {
    width: 70%;
}

#form-title {
    text-style: bold;
    color: #f8f8f2;
    padding-bottom: 1;
}

#form-body {
    height: 1fr;
}

#f-description {
    height: 10;
    border: round #44475a;
    margin-bottom: 1;
}

#f-acceptance-criteria {
    height: 10;
    border: round #44475a;
    margin-bottom: 1;
}

#form-body Label {
    height: 1;
    margin: 0;
    color: #6272a4;
}

#form-body Input {
    margin-bottom: 1;
}

#form-body Select {
    margin-bottom: 0;
}

.form-row {
    height: auto;
    margin-bottom: 1;
}

.form-col {
    width: 1fr;
    height: auto;
    margin-right: 1;
}

#form-actions, #confirm-actions {
    height: auto;
    padding-top: 1;
    align: right middle;
}

#form-actions Button, #confirm-actions Button {
    margin-left: 1;
}

#form-error {
    color: #ff5555;
    height: auto;
    padding-top: 1;
}

#confirm-message {
    padding-bottom: 1;
}

ObjectivesScreen, MetricsScreen, ObjectiveSummaryScreen, RecurringScreen {
    align: center middle;
}

#objectives-dialog, #metrics-dialog, #summary-dialog, #recurring-dialog {
    width: 94%;
    height: 94%;
    background: #313442;
    border: round #bd93f9;
    padding: 1 2;
}

#objectives-title, #metrics-title, #summary-title, #recurring-title {
    text-style: bold;
    color: #f8f8f2;
    padding-bottom: 1;
}

#summary-stats {
    color: #6272a4;
    padding-bottom: 1;
}

#summary-body {
    height: 1fr;
}

.summary-task {
    color: #f8f8f2;
    height: auto;
    margin-bottom: 1;
}

#objectives-hint, #recurring-hint {
    color: #6272a4;
    padding-bottom: 1;
}

#objectives-body, #metrics-body, #recurring-body {
    height: 1fr;
}

#objectives-dialog .form-row, #recurring-dialog .form-row {
    height: auto;
}

#rec-new-name {
    width: 1fr;
    margin-right: 1;
}

#rec-new-interval {
    width: 22;
    margin-right: 1;
}

#rec-new-btn {
    width: auto;
    min-width: 10;
}

#rec-new-description {
    margin-bottom: 1;
}

#recurring-error {
    color: #ff5555;
    height: auto;
    padding-bottom: 1;
}

#recurring-actions {
    height: auto;
    padding-top: 1;
    align: right middle;
}

.recurring-row {
    height: auto;
    margin-bottom: 1;
    padding: 0 1;
}

.recurring-row-header {
    height: 1;
    align: left middle;
}

.recurring-row-name {
    width: 1fr;
    color: #f8f8f2;
}

.recurring-row-description {
    height: 1;
    color: #6272a4;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.recurring-row-btn {
    width: auto;
    min-width: 10;
    height: 1;
    padding: 0 1;
    border: none;
    background: #44475a;
    color: #ffb86c;
    margin-left: 1;
}

#obj-new-name {
    width: 1fr;
    margin-right: 1;
}

#obj-new-priority {
    width: 16;
    margin-right: 1;
}

#obj-new-btn {
    width: auto;
    min-width: 10;
}

#obj-new-description {
    margin-bottom: 1;
}

.objective-row {
    height: auto;
    margin-bottom: 1;
    padding: 0 1;
}

.objective-row.selected-row {
    background: #44475a;
}

.objective-row-header {
    height: 1;
    align: left middle;
}

.objective-row-name {
    width: 1fr;
    color: #f8f8f2;
}

.objective-row-description {
    height: 1;
    color: #6272a4;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.objective-row-reason {
    height: 1;
    color: #6272a4;
    text-style: italic;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.objective-row-btn {
    width: auto;
    min-width: 10;
    height: 1;
    padding: 0 1;
    border: none;
    background: #44475a;
    color: #ffb86c;
}

#objectives-error {
    color: #ff5555;
    height: auto;
    padding-top: 1;
}

#objectives-actions, #metrics-actions, #summary-actions {
    height: auto;
    padding-top: 1;
    align: right middle;
}

.metrics-section {
    text-style: bold;
    color: #6272a4;
    padding-top: 1;
}

.metrics-row {
    color: #f8f8f2;
    height: 1;
}

.metrics-spacer {
    height: 1;
}

SettingsScreen {
    align: center middle;
}

#settings-dialog {
    width: 94%;
    height: 94%;
    background: #313442;
    border: round #bd93f9;
    padding: 1 2;
}

#settings-title {
    text-style: bold;
    color: #f8f8f2;
    padding-bottom: 1;
}

#settings-body {
    height: 1fr;
}

#settings-body Label {
    height: 1;
    margin: 0;
    color: #6272a4;
}

#settings-body Input {
    margin-bottom: 1;
}

.settings-hint {
    color: #6272a4;
    height: auto;
    margin-bottom: 1;
}

.settings-section {
    text-style: bold;
    color: #6272a4;
    padding-top: 1;
}

#settings-error {
    color: #ff5555;
    height: auto;
}

#settings-actions {
    height: auto;
    padding-top: 1;
    align: right middle;
}

#settings-actions Button {
    margin-left: 1;
}

TaskDetailScreen {
    align: center middle;
}

#detail-dialog {
    width: 94%;
    height: 94%;
    background: #313442;
    border: round #bd93f9;
    padding: 1 2;
}

#detail-title {
    text-style: bold;
    color: #f8f8f2;
    padding-bottom: 1;
}

#detail-body {
    height: 1fr;
}

.detail-block {
    color: #f8f8f2;
    height: auto;
    margin-bottom: 1;
}

.detail-comment {
    color: #f8f8f2;
    height: auto;
    margin-bottom: 1;
    padding-left: 1;
}

#detail-actions {
    height: auto;
    padding-top: 1;
    align: right middle;
}

#detail-dialog .form-row {
    padding-top: 1;
}

#detail-comment-input {
    width: 1fr;
    margin-right: 1;
}
