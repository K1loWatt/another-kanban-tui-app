* {
    scrollbar-background: #1c140a;
    scrollbar-background-hover: #2e2112;
    scrollbar-background-active: #2e2112;
    scrollbar-color: #5a4228;
    scrollbar-color-hover: #c9a06a;
    scrollbar-color-active: #ff9d3d;
    scrollbar-corner-color: #1c140a;
}

Screen {
    background: #130e09;
}

Header {
    background: #1c140a;
    color: #e8d2b0;
}

Footer {
    background: #1c140a;
}

#board-header {
    height: 1;
    padding: 0 3;
}

.board-col-header {
    width: 1fr;
    text-style: bold;
    color: #a8835a;
}

#board {
    height: 1fr;
    padding: 1 2;
}

Lane {
    height: auto;
    margin-bottom: 1;
    padding: 0 1;
    border-top: solid #2e2112;
}

Lane.active-lane {
    border-top: solid #ff9d3d;
}

Lane.urgency-lane {
    border-top: solid #7a2a1e;
}

Lane.urgency-lane.active-lane {
    border-top: solid #ff5f56;
}

.lane-header {
    height: 1;
    margin-bottom: 0;
    align: left middle;
}

.lane-title {
    width: 1fr;
    color: #e8c088;
}

.lane-description {
    height: 1;
    color: #8a6a45;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.lane-body {
    height: auto;
}

Column {
    width: 1fr;
    height: auto;
    padding: 0 1;
}

.empty-hint {
    color: #5a4228;
    height: 1;
    padding: 0 1;
}

TaskCard {
    width: 1fr;
    height: 3;
    padding: 0 1;
    background: transparent;
    color: #d8c3a0;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* Expedito: parpadea en rojo */
TaskCard.alert-urgent {
    color: #ffb3a0;
    border-left: thick #ff5f56;
}

TaskCard.alert-urgent.blink-active {
    background: #3a1410;
    color: #ffd9cf;
}

/* Fecha límite próxima: parpadea en ámbar */
TaskCard.alert-approaching {
    border-left: thick #ffcc66;
}

TaskCard.alert-approaching.blink-active {
    background: #3a2a0a;
    color: #ffe9bd;
}

/* Vencida: marca roja fija (sin parpadeo) */
TaskCard.alert-overdue {
    border-left: thick #ff5f56;
    color: #ffbdb0;
}

/* Prioridad baja: marca verde fija */
TaskCard.alert-low {
    border-left: thick #6bbf6b;
}

TaskCard.selected {
    background: #3a2512;
    color: #ffd9a8;
    text-style: bold;
}

TaskCard.selected.blink-active {
    background: #4a3012;
    color: #ffe9c0;
}

TaskFormScreen, ConfirmScreen {
    align: center middle;
}

#form-dialog, #confirm-dialog {
    height: auto;
    max-height: 96%;
    background: #1c140a;
    border: round #ff9d3d;
    padding: 1 2;
}

#form-dialog {
    width: 110;
    max-width: 96%;
}

#confirm-dialog {
    width: 50%;
}

#form-title {
    text-style: bold;
    color: #e8d2b0;
    padding-bottom: 1;
}

#form-body {
    height: auto;
}

#f-description {
    height: 4;
    border: round #2e2112;
    margin-bottom: 1;
}

#f-acceptance-criteria {
    height: 3;
    border: round #2e2112;
    margin-bottom: 1;
}

#form-body Label {
    height: 1;
    margin: 0;
    color: #a8835a;
}

#form-body Input {
    margin-bottom: 1;
}

#form-body Select {
    margin-bottom: 0;
}

.form-row {
    height: auto;
    margin-bottom: 1;
}

.form-col {
    width: 1fr;
    height: auto;
    margin-right: 1;
}

#form-actions, #confirm-actions {
    height: auto;
    padding-top: 1;
    align: right middle;
}

#form-actions Button, #confirm-actions Button {
    margin-left: 1;
}

#form-error {
    color: #ff5f56;
    height: auto;
    padding-top: 1;
}

#confirm-message {
    padding-bottom: 1;
}

ObjectivesScreen, MetricsScreen, ObjectiveSummaryScreen {
    align: center middle;
}

#objectives-dialog, #metrics-dialog, #summary-dialog {
    width: 90;
    max-width: 92%;
    height: auto;
    max-height: 90%;
    background: #1c140a;
    border: round #ff9d3d;
    padding: 1 2;
}

#objectives-dialog {
    width: 110;
    max-width: 96%;
    max-height: 96%;
}

#objectives-title, #metrics-title, #summary-title {
    text-style: bold;
    color: #e8d2b0;
    padding-bottom: 1;
}

#summary-stats {
    color: #a8835a;
    padding-bottom: 1;
}

#summary-body {
    height: auto;
    max-height: 26;
}

.summary-task {
    color: #d8c3a0;
    height: auto;
    margin-bottom: 1;
}

#objectives-hint {
    color: #a8835a;
    padding-bottom: 1;
}

#objectives-body, #metrics-body {
    height: auto;
    max-height: 26;
}

#objectives-dialog #objectives-body {
    max-height: 34;
}

#objectives-dialog .form-row {
    height: auto;
}

#obj-new-name {
    width: 1fr;
    margin-right: 1;
}

#obj-new-priority {
    width: 16;
    margin-right: 1;
}

#obj-new-btn {
    width: auto;
    min-width: 10;
}

#obj-new-description {
    margin-bottom: 1;
}

.objective-row {
    height: auto;
    margin-bottom: 1;
    padding: 0 1;
}

.objective-row.selected-row {
    background: #3a2512;
}

.objective-row-header {
    height: 1;
    align: left middle;
}

.objective-row-name {
    width: 1fr;
    color: #d8c3a0;
}

.objective-row-description {
    height: 1;
    color: #8a6a45;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.objective-row-btn {
    width: auto;
    min-width: 10;
    height: 1;
    padding: 0 1;
    border: none;
    background: #3a2512;
    color: #ffb454;
}

#objectives-error {
    color: #ff5f56;
    height: auto;
    padding-top: 1;
}

#objectives-actions, #metrics-actions, #summary-actions {
    height: auto;
    padding-top: 1;
    align: right middle;
}

.metrics-section {
    text-style: bold;
    color: #c9a06a;
    padding-top: 1;
}

.metrics-row {
    color: #d8c3a0;
    height: 1;
}

.metrics-spacer {
    height: 1;
}
