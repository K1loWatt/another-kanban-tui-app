Screen {
    layers: default overlay;
}

/* Sin barra de scroll en el tablero: así la fila de títulos y los carriles
   tienen exactamente el mismo ancho y las columnas quedan alineadas. */
#board-header {
    height: 1;
    padding: 0 3;
}

.board-col-header {
    width: 1fr;
    text-style: bold;
    color: $foreground;
    padding: 0 1;
}

.board-col-header.header-doing, .board-col-header.header-done {
    border-left: solid $foreground 40%;
}

#board {
    height: 1fr;
    padding: 1 2;
    scrollbar-size-vertical: 0;
}

/* Líneas verticales continuas entre columnas, de la fila de títulos hasta
   el final del tablero, por encima de todos los carriles (posición y alto
   los calcula KanbanApp._place_separators). */
.col-separator {
    layer: overlay;
    position: absolute;
    width: 1;
    height: 1;
    color: $foreground 40%;
}

Lane {
    height: auto;
    margin-bottom: 1;
    padding: 0 1;
    border-top: solid $foreground 40%;
}

/* La línea de arriba de cada carril separa un objetivo del siguiente; el
   activo la lleva gruesa. La frescura va como medidor en el título. */
Lane.active-lane {
    border-top: heavy $foreground;
}

/* Objetivo apagado: todo en gris, pero sigue editable con normalidad. */
Lane.paused-lane .lane-cell {
    color: $text-disabled;
}

Lane.paused-lane TaskCard {
    color: $text-disabled;
    border: round $foreground 15%;
    border-left: thick $foreground 20%;
    background: transparent;
    text-style: none;
}

Lane.paused-lane TaskCard.selected {
    background: $boost;
    color: $text-muted;
    text-style: bold;
    border: heavy $foreground 60%;
}

#stats-banner {
    height: 3;
    width: 1fr;
    background: $panel;
    content-align: center middle;
    padding: 1 0;
    margin: 1 0 2 0;
}

.lane-row {
    height: 1;
}

.lane-cell {
    width: 1fr;
    height: 1;
    padding: 0 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.lane-cell.cell-doing, .lane-cell.cell-done {
    border-left: solid $foreground 40%;
}

.lane-description {
    color: $text-muted;
}

.lane-body {
    height: auto;
}

/* Sin scroll: cada columna muestra como mucho 5 tarjetas (3 filas cada una:
   1 de contenido + borde) y pagina el resto (ver Column en column.py). */
Column {
    width: 1fr;
    height: 16;
    padding: 0 1;
}

/* Separador vertical bien visible entre columnas. */
Column.column-doing, Column.column-done {
    border-left: solid $foreground 40%;
}

.column-pager {
    height: 1;
    color: $text-muted;
    content-align: center middle;
    width: 1fr;
}

/* Ojo: en Textual `padding-bottom` solo resetea también los otros lados. */
Lane.active-lane {
    padding: 0 1 1 1;
}

.empty-hint {
    color: $text-muted;
    height: 3;
    padding: 0 1;
    border: round $foreground 20%;
}

.empty-hint.selected {
    color: $accent;
    border: heavy $accent;
}

/* Borde suave en cada tarjeta para separar visualmente una tarea de otra. */
TaskCard {
    width: 1fr;
    height: 3;
    padding: 0 1;
    background: transparent;
    color: $foreground;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    border: round $foreground 25%;
}

/* Alertas: cada una con su forma de borde izquierdo, para distinguirlas
   también en blanco y negro. Nada parpadea ni cambia de color: solo
   cambia la forma del borde (el color de la línea lo pone el tema).
   Bloqueada: doble ║ */
TaskCard.alert-blocked {
    border-left: double $error;
}

/* Atascada en progreso: discontinuo ╏ */
TaskCard.alert-stuck {
    border-left: dashed $secondary;
}

/* Expedito: bloque lleno █ */
TaskCard.alert-urgent {
    border-left: block $error;
}

/* Fecha límite próxima: grueso ┃ */
TaskCard.alert-approaching {
    border-left: heavy $warning;
}

/* Vencida: medio bloque ▌ */
TaskCard.alert-overdue {
    border-left: outer $error;
}

/* Prioridad baja: ascii | */
TaskCard.alert-low {
    border-left: ascii $success;
}

/* Tarea seleccionada: borde grueso (color de acento del tema) en tres lados; el lado izquierdo
   conserva el color de alerta (si lo hay) para no perder esa información. */
TaskCard.selected {
    background: $boost;
    color: $accent;
    text-style: bold;
    border-top: heavy $accent;
    border-right: heavy $accent;
    border-bottom: heavy $accent;
}

TaskCard.selected.alert-normal {
    border-left: heavy $accent;
}

TaskFormScreen, ConfirmScreen {
    align: center middle;
}

#form-dialog, #confirm-dialog {
    height: auto;
    max-height: 96%;
    background: $surface;
    border: round $primary;
    padding: 1 2;
}

#form-dialog {
    width: 94%;
    height: 94%;
}

#confirm-dialog {
    width: 70%;
}

#form-title {
    text-style: bold;
    color: $foreground;
    padding-bottom: 1;
}

#form-body {
    height: 1fr;
}

#f-description {
    height: 10;
    border: round $foreground 25%;
    margin-bottom: 1;
}

#f-acceptance-criteria {
    height: 10;
    border: round $foreground 25%;
    margin-bottom: 1;
}

#form-body Label {
    height: 1;
    margin: 0;
    color: $text-muted;
}

#form-body Input {
    margin-bottom: 1;
}

#form-body Select {
    margin-bottom: 0;
}

.form-row {
    height: auto;
    margin-bottom: 1;
}

.form-col {
    width: 1fr;
    height: auto;
    margin-right: 1;
}

#form-actions, #confirm-actions {
    height: auto;
    padding-top: 1;
    align: right middle;
}

#form-actions Button, #confirm-actions Button {
    margin-left: 1;
}

#form-error {
    color: $error;
    height: auto;
    padding-top: 1;
}

#confirm-message {
    padding-bottom: 1;
}

ObjectivesScreen, MetricsScreen, ObjectiveSummaryScreen, RecurringScreen {
    align: center middle;
}

#objectives-dialog, #metrics-dialog, #summary-dialog, #recurring-dialog {
    width: 94%;
    height: 94%;
    background: $surface;
    border: round $primary;
    padding: 1 2;
}

#objectives-title, #metrics-title, #summary-title, #recurring-title {
    text-style: bold;
    color: $foreground;
    padding-bottom: 1;
}

#summary-stats {
    color: $text-muted;
    padding-bottom: 1;
}

#summary-body {
    height: 1fr;
}

.summary-task {
    color: $foreground;
    height: auto;
    margin-bottom: 1;
}

#objectives-hint, #recurring-hint {
    color: $text-muted;
    padding-bottom: 1;
}

#objectives-body, #metrics-body, #recurring-body {
    height: 1fr;
}

#objectives-dialog .form-row, #recurring-dialog .form-row {
    height: auto;
}

#rec-new-name {
    width: 1fr;
    margin-right: 1;
}

#rec-new-interval {
    width: 22;
    margin-right: 1;
}

#rec-new-btn {
    width: auto;
    min-width: 10;
}

#rec-new-description {
    margin-bottom: 1;
}

#recurring-error {
    color: $error;
    height: auto;
    padding-bottom: 1;
}

#recurring-actions {
    height: auto;
    padding-top: 1;
    align: right middle;
}

.recurring-row {
    height: auto;
    margin-bottom: 1;
    padding: 0 1;
}

.recurring-row-header {
    height: 1;
    align: left middle;
}

.recurring-row-name {
    width: 1fr;
    color: $foreground;
}

.recurring-row-description {
    height: 1;
    color: $text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.recurring-row-btn {
    width: auto;
    min-width: 10;
    height: 1;
    padding: 0 1;
    border: none;
    background: $panel;
    color: $warning;
    margin-left: 1;
}

#obj-new-name {
    width: 1fr;
    margin-right: 1;
}

#obj-new-priority {
    width: 16;
    margin-right: 1;
}

#obj-new-btn {
    width: auto;
    min-width: 10;
}

#obj-new-description {
    margin-bottom: 1;
}

.objective-row {
    height: auto;
    margin-bottom: 1;
    padding: 0 1;
}

.objective-row.selected-row {
    background: $boost;
    color: $accent;
}

.objective-row-header {
    height: 1;
    align: left middle;
}

.objective-row-name {
    width: 1fr;
    color: $foreground;
}

.objective-row-description {
    height: 1;
    color: $text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.objective-row-reason {
    height: 1;
    color: $text-muted;
    text-style: italic;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.objective-row-btn {
    width: auto;
    min-width: 10;
    height: 1;
    padding: 0 1;
    border: none;
    background: $panel;
    color: $warning;
}

#objectives-error {
    color: $error;
    height: auto;
    padding-top: 1;
}

#objectives-actions, #metrics-actions, #summary-actions {
    height: auto;
    padding-top: 1;
    align: right middle;
}

.metrics-section {
    text-style: bold;
    color: $text-muted;
    padding-top: 1;
}

.metrics-row {
    color: $foreground;
    height: 1;
}

.metrics-spacer {
    height: 1;
}

SettingsScreen {
    align: center middle;
}

#settings-dialog {
    width: 94%;
    height: 94%;
    background: $surface;
    border: round $primary;
    padding: 1 2;
}

#settings-title {
    text-style: bold;
    color: $foreground;
    padding-bottom: 1;
}

#settings-body {
    height: 1fr;
}

#settings-body Label {
    height: 1;
    margin: 0;
    color: $text-muted;
}

#settings-body Input {
    margin-bottom: 1;
}

.settings-hint {
    color: $text-muted;
    height: auto;
    margin-bottom: 1;
}

.settings-section {
    text-style: bold;
    color: $text-muted;
    padding-top: 1;
}

#settings-error {
    color: $error;
    height: auto;
}

#settings-actions {
    height: auto;
    padding-top: 1;
    align: right middle;
}

#settings-actions Button {
    margin-left: 1;
}

TaskDetailScreen {
    align: center middle;
}

#detail-dialog {
    width: 94%;
    height: 94%;
    background: $surface;
    border: round $primary;
    padding: 1 2;
}

#detail-title {
    text-style: bold;
    color: $foreground;
    padding-bottom: 1;
}

#detail-body {
    height: 1fr;
}

.detail-block {
    color: $foreground;
    height: auto;
    margin-bottom: 1;
}

.detail-comment {
    color: $foreground;
    height: auto;
    margin-bottom: 1;
    padding-left: 1;
}

#detail-actions {
    height: auto;
    padding-top: 1;
    align: right middle;
}

#detail-dialog .form-row {
    padding-top: 1;
}

#detail-comment-input {
    width: 1fr;
    margin-right: 1;
}

WipScreen {
    align: center middle;
}

#wip-dialog {
    width: 94%;
    height: 94%;
    background: $surface;
    border: round $primary;
    padding: 1 2;
}

#wip-title {
    text-style: bold;
    color: $foreground;
    padding-bottom: 1;
}

#wip-hint {
    color: $text-muted;
    padding-bottom: 1;
}

#wip-body {
    height: 1fr;
}

.wip-row {
    height: 3;
    padding: 0 1;
    color: $foreground;
    border: round $foreground 25%;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.wip-row.selected {
    background: $boost;
    color: $accent;
    text-style: bold;
    border: heavy $accent;
}

#objectives-actions Button, #recurring-actions Button {
    margin-left: 1;
}
